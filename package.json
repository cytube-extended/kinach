{
  "name": "kinach",
  "version": "2.0.0",
  "license": "ISC",
  "author": "basevich",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit --project typecheck.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt -c .oxfmtrc.json --check",
    "rebuild": "docker compose build && vite build --mode production",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "dev": "docker compose up -d && vite build --mode development --watch",
    "close": "docker compose down"
  },
  "devDependencies": {
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/svelte": "^1.1.2",
    "@internationalized/date": "^3.12.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/jquery": "1.10.27",
    "@types/node": "^25.9.3",
    "@types/socket.io-client": "1.4.36",
    "@types/youtube-player": "^5.5.11",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "paneforge": "^1.0.2",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.56.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "valibot": "^1.4.1",
    "vite": "^8.0.16",
    "youtube-player": "^5.6.0"
  }
}
