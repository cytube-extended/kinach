{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "env": {
    "browser": true,
    "es2022": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 10
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "style": "warn",
    "pedantic": "off"
  },

  "rules": {
    "sort-imports": "off",
    "unicorn/prefer-global-this": "off",
    "capitalized-comments": "off",
    "max-statements": [
      "warn",
      {
        "max": 16
      }
    ],
    "sort-keys": "off",
    "no-magic-numbers": [
      "warn",
      {
        "ignore": [0, 1]
      }
    ],
    "id-length": [
      "warn",
      {
        "checkGeneric": false
      }
    ]
  },

  "overrides": [
    {
      "files": ["**/*.svelte"],
      "rules": {
        "no-inner-declarations": "off",
        "no-self-assign": "off",
        "prefer-const": "off",
        "unicorn/filename-case": "off",
        "no-ternary": "off"
      }
    }
  ],

  "ignorePatterns": [
    "*.json",
    "*.css",

    "dist/**",
    "build/**",
    "public/**",

    "src/lib/components/ui/**",

    "vite.config.ts"
  ]
}
